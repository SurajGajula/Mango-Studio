# Copy to `.env.local` and fill in real values. Cursor agents may inject these at runtime instead.
# Minimum for `npm run dev` (middleware): the two NEXT_PUBLIC_SUPABASE_* lines below.

NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder

# Server-side Supabase (admin client, etc.)
SUPABASE_SECRET_KEY=

# AI (genaiClient uses GEMINI_API_KEY first, then GOOGLE_API_KEY)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional: override auth redirect origin in dev/proxy setups
# NEXT_PUBLIC_AUTH_REDIRECT_ORIGIN=

# Stripe (required for `npm run build` / checkout, portal, webhook routes)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
